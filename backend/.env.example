APP_NAME=NEMI Backend
APP_ENV=development
JWT_SECRET=dev-change-me
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=60
REDIS_URL=redis://localhost:6379/0
STT_PROVIDER=llm
STT_MODEL=base
STT_LANGUAGE=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_SEGMENT_MAX_MS=2000
STT_SEGMENT_MIN_MS=0
VAD_PADDING_MS=160
MT_PROVIDER=llm
MT_MODEL=facebook/nllb-200-distilled-600M
MT_MODELS=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=45
TRANSLATION_CONTEXT_SEGMENTS=4
TRANSLATION_GLOSSARY_PATH=/app/app/config/glossary.json
PHRASE_MIN_CHARS=24
PHRASE_MAX_CHARS=220
PHRASE_TIMEOUT_MS=1800
TTS_PROVIDER=none
TTS_MODELS=
TTS_MODEL_PATH=
TTS_SAMPLE_RATE=0
LISTENER_DELAY_MS=700
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-exp
LLM_API_KEY=
LLM_FAKE_TRANSCRIPTS=false
LLM_FAKE_TRANSLATIONS=false
ADMIN_USER=admin
ADMIN_PASSWORD=admin
